# 서버 사이드에서만 읽힙니다 (NEXT_PUBLIC_ 접두사 금지). 실제 키는 .env.local 또는 Vercel 환경변수에만 저장하세요.
GEMINI_API_KEY=

# 1순위 모델 (최신 모델 ID). 예: gemini-4-hydrogen, gemini-4-neon
GEMINI_MODEL=gemini-4-hydrogen

# 2순위 안정화 Flash 모델 (미지정 시 gemini-3.8-flash)
# 참고: gemini-2.5-flash는 신규 API 키에서 404(신규 사용자 미제공)를 반환함
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# 3.x/4.x 모델 사고 수준 (LOW 권장, DEFAULT=모델 기본값). 2.5 Flash는 자동으로 thinkingBudget=0
GEMINI_THINKING_LEVEL=LOW

# 모델 1회 시도당 타임아웃(ms)
GEMINI_TIMEOUT_MS=25000
